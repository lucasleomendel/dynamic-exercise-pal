VITE_SUPABASE_URL=https://jscquwhtsjdzripqfugf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_aqui

# Geração de imagens (consome créditos da API de IA; ativar apenas quando desejado)
